NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_your_password

# Primary provider
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_COMPLETION_TOKENS=768
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=1

# Fallback 1-2 (each key becomes a separate fallback attempt)
GROQ_API_KEY_1=replace_with_your_key
GROQ_API_KEY_2=replace_with_your_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=768
GROQ_TIMEOUT_SECONDS=120
GROQ_MAX_RETRIES=1

# Fallback 4 (currently requires billing on SambaCloud)
SAMBANOVA_API_KEY=replace_with_your_key
SAMBANOVA_MODEL=gpt-oss-120b
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MAX_COMPLETION_TOKENS=768
SAMBANOVA_TIMEOUT_SECONDS=120
SAMBANOVA_MAX_RETRIES=1

# Fallback 5 (currently requires billing on Cerebras)
CEREBRAS_API_KEY=replace_with_your_key
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MAX_COMPLETION_TOKENS=768
CEREBRAS_TIMEOUT_SECONDS=120
CEREBRAS_MAX_RETRIES=1

# Fallback 3
MISTRAL_API_KEY=replace_with_your_key
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MAX_COMPLETION_TOKENS=768
MISTRAL_TIMEOUT_SECONDS=120
MISTRAL_MAX_RETRIES=1

AGENT_HISTORY_TURNS=3
AGENT_HISTORY_MAX_CHARS=16000
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=15
ROUTE_OPTIMIZER_TIME_LIMIT_MS=500
SOULVIET_AGENT_DB_DIR=.soulviet
